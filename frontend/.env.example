# Copy to frontend/.env.local for local development against the real backend.
# Firebase Console -> Project settings -> Your apps -> Web app -> SDK config.
# These identify the Firebase project and are safe to ship to the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Where `npm run dev` forwards /api requests (default http://localhost:3000).
# Set it in your shell, e.g. VITE_API_PROXY_TARGET=http://localhost:3001 npm run dev
# VITE_API_PROXY_TARGET=http://localhost:3000
