flowchart TB
    user["User (web browser)"]
    lb["DigitalOcean Load Balancer (HTTPS)"]
    mon["DigitalOcean Monitoring<br/>CPU / memory / disk + alerts"]
    gh["GitHub Actions<br/>(test, build, deploy)"]
    reg["DO Container Registry"]

    subgraph doks["DigitalOcean Kubernetes (DOKS) cluster"]
        ingress["Ingress controller"]
        fe["Next.js frontend<br/>Deployment · 2 pods"]
        api["FastAPI backend<br/>Deployment · 2–5 pods"]
        hpa["Horizontal Pod Autoscaler<br/>(CPU 70%)"]
        sec["Kubernetes Secrets<br/>(DB password, keys)"]
        pg["PostgreSQL<br/>StatefulSet · 1 pod"]
        pvc["PersistentVolumeClaim<br/>(do-block-storage)"]
    end

    vol[("DigitalOcean Volume<br/>(block storage)")]
    fn["DigitalOcean Function<br/>(serverless)"]
    sg["SendGrid (email)"]

    user --> lb --> ingress
    ingress -- "/*" --> fe
    ingress -- "/api/*" --> api
    fe -. "API calls" .-> api
    hpa -. "scales" .-> api
    sec -.-> api
    api -- "SQL" --> pg
    pg --- pvc
    pvc -- "mounted" --> vol
    api -- "async event<br/>(new follower / review)" --> fn
    fn --> sg
    gh -- "push images (tagged by SHA)" --> reg
    reg -. "rolling update" .-> doks
    mon -. "metrics" .-> doks
