POSTGRES_DB=restaurant_app
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5432

BACKEND_PORT=3000
FRONTEND_PORT=8080
# Firebase project ID (Firebase Console -> Project settings). Needed to verify sign-ins.
FIREBASE_PROJECT_ID=ece1779-28b5d
# Local testing only: lets "Bearer dev:<firebase_uid>" sign in as a seed user. Ignored in production.
AUTH_DEV_BYPASS=false
# Firebase web config, baked into the frontend at build time (same as the VITE_FIREBASE_* CD secrets).
# Firebase Console -> Project settings -> Your apps -> Web app. Safe to ship to the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=ece1779-28b5d
VITE_FIREBASE_APP_ID=
